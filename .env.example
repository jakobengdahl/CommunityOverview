# =============================================================================
# CommunityOverview - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your values
#   docker compose up -d
# =============================================================================

# === LLM Provider Configuration ===
# Choose provider: "claude" or "openai" (default: claude)
LLM_PROVIDER=claude

# Anthropic API Key (required if LLM_PROVIDER=claude)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-xxxxx

# OpenAI API Key (required if LLM_PROVIDER=openai)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OpenAI Model (only used when LLM_PROVIDER=openai)
# Options: gpt-4o, gpt-4-turbo, gpt-4, gpt-3.5-turbo
OPENAI_MODEL=gpt-4o

# Optional: custom base URL for OpenAI-compatible APIs
# Enables use of self-hosted models, Azure OpenAI, or any other compatible service.
# Leave unset to use the default OpenAI API endpoint (api.openai.com).
#
# Examples:
#   Ollama:       OPENAI_BASE_URL=http://localhost:11434/v1
#   vLLM:         OPENAI_BASE_URL=http://localhost:8000/v1
#   Azure OpenAI: OPENAI_BASE_URL=https://<resource>.openai.azure.com/openai/deployments/<deployment>
#   OpenWebUI:    OPENAI_BASE_URL=http://localhost:3000/openai
# OPENAI_BASE_URL=

# Set to false if using a model that does not support function/tool calling (default: true)
# OPENAI_TOOL_CALLING=true

# === Authentication ===
# Enable Basic Authentication (default: false)
AUTH_ENABLED=false

# Username for Basic Auth (default: admin)
AUTH_USERNAME=admin

# Password for Basic Auth (required if AUTH_ENABLED=true)
# IMPORTANT: Use a strong password in production!
AUTH_PASSWORD=

# === Server Configuration ===
# Port to expose (default: 8000)
PORT=8000

# API endpoint prefix (default: /api)
# API_PREFIX=/api

# MCP server identifier (default: community-knowledge-graph)
# MCP_NAME=community-knowledge-graph

# === Data Paths (usually don't need to change) ===
# Path to graph data file (inside container)
# GRAPH_FILE=/data/graph.json

# Path to schema configuration (inside container)
# SCHEMA_FILE=/app/config/default/schema_config.json

# Path to the binary embedding sidecar (optional). Defaults to
# "<graph stem>.embeddings.bin" next to GRAPH_FILE, which is what most
# deployments want. A relative value resolves against GRAPH_FILE's directory.
# Never point this at a legacy embeddings.pkl - it is a different format and
# would be overwritten.
# EMBEDDINGS_FILE=/data/graph.embeddings.bin
