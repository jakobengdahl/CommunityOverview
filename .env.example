# =============================================================================
# CommunityOverview - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your values
#   docker compose up -d
# =============================================================================

# === LLM Provider Configuration ===
# Choose provider: "claude" or "openai" (default: claude)
LLM_PROVIDER=claude

# Anthropic API Key (required if LLM_PROVIDER=claude)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-xxxxx

# OpenAI API Key (required if LLM_PROVIDER=openai)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OpenAI Model (only used when LLM_PROVIDER=openai)
# Options: gpt-4o, gpt-4-turbo, gpt-4, gpt-3.5-turbo
OPENAI_MODEL=gpt-4o

# Optional: completion token limit for chat and agent calls (default 16000)
# LLM_MAX_TOKENS=16000

# Optional: maximum LLM rounds per chat chain (default 64)
# CHAT_MAX_ROUNDS=64
# Optional: total deadline per chat model call in seconds (1–86400; default 600).
# Includes network operations; SDK retries disabled for chat, connect timeout 5 s.
# LLM_TIMEOUT_SECONDS=600

# Optional: set to false to send chat_template_kwargs enable_thinking=false on
# OpenAI-compatible requests, for models that spend the limit on reasoning
# LLM_ENABLE_THINKING=false

# Optional: custom base URL for OpenAI-compatible APIs
# Enables use of self-hosted models, Azure OpenAI, or any other compatible service.
# Leave unset to use the default OpenAI API endpoint (api.openai.com).
#
# Examples:
#   Ollama:       OPENAI_BASE_URL=http://localhost:11434/v1
#   vLLM:         OPENAI_BASE_URL=http://localhost:8000/v1
#   Azure OpenAI: OPENAI_BASE_URL=https://<resource>.openai.azure.com/openai/deployments/<deployment>
#   OpenWebUI:    OPENAI_BASE_URL=http://localhost:3000/openai
# OPENAI_BASE_URL=

# Set to false if using a model that does not support function/tool calling (default: true)
# OPENAI_TOOL_CALLING=true

# === Authentication ===
# Enable Basic Authentication (default: false)
AUTH_ENABLED=false

# Username for Basic Auth (default: admin)
AUTH_USERNAME=admin

# Password for Basic Auth (required if AUTH_ENABLED=true)
# IMPORTANT: Use a strong password in production!
AUTH_PASSWORD=

# Peer addresses (IPs or CIDR ranges, comma-separated) of proxies whose inbound
# x-communityoverview-actor-id/-actor-type/-auth-source headers are kept
# (default: none). Headers from any other peer are stripped and the request
# actor is the authenticated user. List only a proxy that authenticates users
# and overwrites those headers on every request it forwards.
# TRUSTED_ACTOR_PROXIES=

# === Server Configuration ===
# Port to expose (default: 8000)
PORT=8000

# API endpoint prefix (default: /api)
# API_PREFIX=/api

# MCP server identifier (default: community-knowledge-graph)
# MCP_NAME=community-knowledge-graph

# Root directory the AI agent's filesystem tools may read and write, and the
# root handed to the filesystem MCP server. Defaults to
# ~/.communityoverview/agent-workspace; a uid with no home directory (a
# container run as an arbitrary uid) falls back to a per-uid directory under the
# system temp dir. Whatever you set must be owned by the service user and not
# writable by others - the FS tools refuse a root they do not own, because a
# directory another local user can pre-create lets them choose where the agent
# reads and writes. Use an absolute path: ~ expands only when the service user
# has a home directory. Any path still relative after expansion resolves
# against the process's working directory.
# AGENTS_WORKSPACE_DIR=/var/lib/communityoverview/agent-workspace

# === Data Paths (usually don't need to change) ===
# Path to graph data file (inside container)
# GRAPH_FILE=/data/graph.json

# Path to schema configuration (inside container)
# SCHEMA_FILE=/app/config/default/schema_config.json

# Path to the binary embedding sidecar (optional). Defaults to
# "<graph stem>.embeddings.bin" next to GRAPH_FILE, which is what most
# deployments want. A relative value resolves against GRAPH_FILE's directory.
# Never point this at a legacy embeddings.pkl: it is a different format, and
# the app refuses to write a sidecar over a file it does not recognise, so the
# vectors simply stop being persisted until the path is corrected.
# EMBEDDINGS_FILE=/data/graph.embeddings.bin

# === Skill-Evaluation Harness (optional, measurement only) ===
# The harness in backend/evaluation reads each provider's credential from the
# environment variable that provider's profile names in `credential_ref`, at the
# moment the call is made. These are examples of such variables; the names are
# yours to choose and must match your profile file. Leave them empty here and
# export the real values in your own shell only - never commit a value.
#
# See docs/SKILL_EVALUATION.md for the profile file format and how to run it.
#
# SKILL_EVAL_OPENAI_API_KEY=
# SKILL_EVAL_OPEN_MODEL_API_KEY=
#
# IMPORTANT: export these in your shell; do not put values in .env. Unlike the
# application settings above, a .env value is UNRELIABLE for the harness rather
# than simply discouraged: the CLI refuses it outright (it checks credentials
# before anything imports the assistant, so load_dotenv has not run), while a
# library caller may accept it or not depending on whether something in the
# process has already imported the assistant. Same input, different answer.
# See docs/SKILL_EVALUATION.md.

# Attachment read tools (ADR 0010). Keep off until the conversation taint,
# Agent egress/output and log-redaction controls are installed (see backend/DEVELOPMENT.md).
# ATTACHMENT_CONTENT_ACCESS=off
# ASSISTANT_ATTACHMENT_ACCESS=off
# ATTACHMENT_SEARCH_MAX_QUERY_CHARS=500
# ATTACHMENT_SEARCH_MAX_NODES=20
# ATTACHMENT_SEARCH_MAX_FILES=40
# ATTACHMENT_SEARCH_MAX_TOTAL_CHARS=4000000
# ATTACHMENT_SEARCH_TIMEOUT_SECONDS=120
# ATTACHMENT_SEARCH_MAX_TOP_K=20
# ATTACHMENT_RERANK_CANDIDATES=32
# ATTACHMENT_CHUNK_CHARS=1200
# ATTACHMENT_CHUNK_OVERLAP_CHARS=200
# ATTACHMENT_RESULT_MAX_CHARS=24000
# ATTACHMENT_READ_MAX_CHARS=50000
# ATTACHMENT_TEXT_CACHE_MAX_CHARS=20000000
# ATTACHMENT_EXTRACT_CONCURRENCY=2

# Chat attachment confirmations (process-local; use one worker or sticky routing).
# ATTACHMENT_CONFIRMATION_TTL_SECONDS=600
# ATTACHMENT_PENDING_ACTIONS_PER_TURN=5
# ATTACHMENT_PENDING_ACTIONS_MAX=1000
