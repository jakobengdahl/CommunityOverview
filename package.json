{
  "name": "community-graph",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "frontend/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build -w @community-graph/web",
    "build:widget": "npm run build -w @community-graph/widget",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "npm run test --workspaces --if-present",
    "test:widget": "npm run test -w @community-graph/widget",
    "test:canvas": "npm run test -w @community-graph/ui-graph-canvas",
    "test:e2e": "npm run test:e2e -w @community-graph/web",
    "test:e2e-live": "./scripts/test-e2e.sh",
    "test:python": "python -m pytest backend",
    "test:integration": "python -m pytest backend/service/tests/test_integration_rest_vs_mcp.py -v",
    "test:all": "npm run test:python && npm run test:unit",
    "dev": "npm run dev -w @community-graph/web",
    "lint": "eslint \"frontend/**/*.{js,jsx}\" \"packages/**/*.{js,jsx}\"",
    "lint:fix": "eslint --fix \"frontend/**/*.{js,jsx}\" \"packages/**/*.{js,jsx}\"",
    "format": "prettier --write \"frontend/**/*.{js,jsx,css}\" \"packages/**/*.{js,jsx,css}\"",
    "format:check": "prettier --check \"frontend/**/*.{js,jsx,css}\" \"packages/**/*.{js,jsx,css}\""
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "prettier": "3.9.5"
  }
}
