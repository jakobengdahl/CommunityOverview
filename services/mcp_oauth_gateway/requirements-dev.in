# Development and testing dependencies for the MCP OAuth Gateway (source of truth).
#
# requirements-dev.txt is GENERATED from this file with fully-pinned,
# hash-verified dependencies. After editing this file, regenerate the lock:
#
#   uv pip compile --universal --generate-hashes \
#     services/mcp_oauth_gateway/requirements-dev.in \
#     -o services/mcp_oauth_gateway/requirements-dev.txt

# Includes the pinned runtime requirements.
-r requirements.in

# Testing
pytest>=7.0.0

# The repo-wide `timeout = 300` in the root pyproject.toml applies here too
# (pytest walks up to find it), but only takes effect with this plugin
# installed - without it, pytest just warns "Unknown config option: timeout"
# and a hang runs until the CI runner itself kills the job, with no red test
# to name.
pytest-timeout>=2.1.0

# starlette's TestClient imports the literal `httpx` package for its in-process
# ASGI transport. The gateway's runtime HTTP client is httpx2, so plain httpx is
# a test-only dependency and is intentionally kept out of requirements.in.
httpx>=0.27.0
