# =============================================================================
# Profile Environment Configuration
# =============================================================================
# Each profile can have its own .env file for secrets and overrides.
# Copy this to .env in your profile directory and fill in values.
#
# Fallback chain: profile .env → config/default/.env → root .env
# Variables already set in the environment are never overridden.
# =============================================================================

# === LLM Provider Configuration ===
# LLM_PROVIDER=claude
# ANTHROPIC_API_KEY=sk-ant-api03-xxxxx
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=      # Optional: custom endpoint for OpenAI-compatible APIs (Ollama, vLLM, Azure, etc.)
# OPENAI_TOOL_CALLING=true  # Set to false for models without function-calling support

# === Authentication ===
# AUTH_ENABLED=false
# AUTH_USERNAME=admin
# AUTH_PASSWORD=

# === Language ===
# APP_LANGUAGE=en
