{
  "schema": {
    "node_types": {
      "CustomActor": {
        "fields": ["name", "description", "custom_field"],
        "description": "Custom actor type for testing",
        "color": "#FF0000"
      },
      "TestNode": {
        "fields": ["name", "summary"],
        "description": "Test node type",
        "color": "#00FF00"
      },
      "Questionnaire": {
        "fields": ["name", "description", "summary", "tags", "subtypes"],
        "category": "domain",
        "description": "Questionnaire or survey form",
        "color": "#7C3AED",
        "icon": "ClipboardCheckFill",
        "context_menu": [
          {
            "label": "Open in Questionnaire-system",
            "action": {
              "type": "open_url",
              "url": "https://questionnaire-system.com/questionnairename/{name}"
            }
          }
        ]
      }
    },
    "relationship_types": {
      "CUSTOM_RELATION": {
        "description": "Custom relationship for testing"
      },
      "TEST_EDGE": {
        "description": "Test edge type",
        "source_types": ["CustomActor"],
        "target_types": ["TestNode"]
      }
    }
  },
  "presentation": {
    "title": "Test Knowledge Graph",
    "introduction": "This is a test instance.",
    "colors": {
      "CustomActor": "#FF0000",
      "TestNode": "#00FF00"
    },
    "prompt_prefix": "You are a test assistant.",
    "prompt_suffix": "Always be helpful in tests.",
    "default_language": "en",
    "language_policy": {
      "mode": "required",
      "primary_language": "en",
      "allowed_languages": ["en"],
      "description_sv": "Grafens innehåll ska skrivas på engelska.",
      "description_en": "Graph content must be written in English."
    },
    "capabilities": [
      {
        "id": "graph_export",
        "name": "Graph export",
        "description": "Allows clients to export graph data for offline analysis.",
        "enabled": true
      },
      {
        "id": "assistant_guidance",
        "name": "Assistant guidance",
        "description": "Provides configuration for guided assistant interactions.",
        "enabled": false
      }
    ]
  }
